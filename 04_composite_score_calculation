################################################################################
# Section 4: Composite score calculation and age standardization
################################################################################

library(dplyr)
library(tidyr)
library(ggplot2)


################################################################################
# 4.1 Calculate composite scores for PUMA dimensions
################################################################################

# Load data
data_org <- read.csv("1a.csv", stringsAsFactors = FALSE)
df_clean <- read.csv("df_1a_clean.csv")

# Load PCA results
pca_fit <- readRDS("pca_fit_data.rds")
pca_scores <- as.data.frame(pca_fit$Component.scores)

# Number of PUMA dimensions
n_pcs <- 7


for (pc in seq_len(n_pcs)) {

  message("Calculating composite score for PC", pc)

  # PCA score for the current component
  target_pca_score <- pca_scores[[pc]]

  # Load variables contributing to the current component
  selected <- read.csv(
    paste0(
      "pc",
      pc,
      "_filtered_sorted_pvalues_by_partial_corrolation.csv"
    )
  )

  # The first entry is excluded, as in the original analysis
  selected_variables <- selected$variable[-1]

  # Data used to reconstruct the PCA score
  model_data <- df_clean[, selected_variables, drop = FALSE]

  # Fit a multiple linear regression model
  model <- lm(
    target_pca_score ~ .,
    data = model_data
  )

  # Calculate the composite score
  model_data$composite_score <- predict(model)

  # Add participant information
  model_data$project_pseudo_id <- data_org$project_pseudo_id
  model_data$age <- df_clean$age

  # Save composite scores
  output_file <- paste0(
    "composite_score_PC",
    pc,
    "_LM.csv"
  )

  write.csv(
    model_data,
    file = output_file,
    row.names = FALSE
  )
}


################################################################################
# 4.2 Examine composite scores across age groups
################################################################################

# Read composite scores for all seven dimensions
composite_scores <- lapply(seq_len(n_pcs), function(pc) {

  df <- read.csv(
    paste0(
      "composite_score_PC",
      pc,
      "_LM.csv"
    )
  )

  data.frame(
    project_pseudo_id = df$project_pseudo_id,
    age = df$age,
    PC = paste0("PC", pc),
    composite_score = df$composite_score
  )

}) %>%
  bind_rows()


# Create 10-year age groups and calculate mean composite scores
composite_scores_by_age <- composite_scores %>%
  mutate(
    age_group = cut(
      age,
      breaks = seq(0, 100, by = 10),
      include.lowest = TRUE
    )
  ) %>%
  group_by(PC, age_group) %>%
  summarise(
    mean_composite_score = mean(
      composite_score,
      na.rm = TRUE
    ),
    .groups = "drop"
  )


# Plot composite scores across age groups
p <- ggplot(
  composite_scores_by_age,
  aes(
    x = age_group,
    y = mean_composite_score,
    group = PC,
    color = PC
  )
) +
  geom_line(
    linewidth = 1.5
  ) +
  geom_point(
    size = 4
  ) +
  labs(
    x = "Age group",
    y = "Mean composite score",
    title = "Composite Scores by Age Group"
  ) +
  theme(
    legend.position = "right",
    axis.text = element_text(size = 14),
    axis.title = element_text(size = 16),
    plot.title = element_text(
      size = 18,
      hjust = 0.5
    )
  )


ggsave(
  filename = "composite_score_vs_ages.pdf",
  plot = p,
  width = 15,
  height = 12
)


################################################################################
# 4.3 Age-standardize composite scores using a rolling reference window
################################################################################

# This function standardizes each participant's composite score relative to
# participants with nearby positions in the age-ranked dataset.
#
# For each participant, the reference window includes up to 'window_size'
# participants below and above that participant in the age-ranked dataset.

age_standardize_rolling <- function(
  data,
  window_size = 500
) {

  # Sort participants by age
  data <- data %>%
    arrange(age)

  scores <- data$composite_score
  n <- length(scores)

  # Calculate the local mean and standard deviation
  rolling_stats <- vapply(
    seq_len(n),
    function(i) {

      start_index <- max(
        1,
        i - window_size
      )

      end_index <- min(
        n,
        i + window_size
      )

      reference_scores <- scores[
        start_index:end_index
      ]

      c(
        mean = mean(
          reference_scores,
          na.rm = TRUE
        ),
        sd = sd(
          reference_scores,
          na.rm = TRUE
        )
      )
    },
    numeric(2)
  )

  # Calculate age-standardized scores
  data <- data %>%
    mutate(
      original_composite_score = composite_score,

      rolling_mean = rolling_stats[
        "mean",
      ],

      rolling_sd = rolling_stats[
        "sd",
      ],

      general_z_score = ifelse(
        is.na(rolling_sd) |
          rolling_sd == 0,
        0,
        (
          composite_score -
            rolling_mean
        ) / rolling_sd
      ),

      composite_score = general_z_score
    ) %>%
    select(
      -rolling_mean,
      -rolling_sd
    )

  return(data)
}


# Apply general age standardization when disease-specific
# standardization is not requested
