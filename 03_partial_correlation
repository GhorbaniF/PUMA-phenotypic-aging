################################################################################
# Section 3: Partial correlation analysis
################################################################################

library(ppcor)


################################################################################
# 3.1 Prepare data
################################################################################

# Retain the selected PCA components
df_pca <- pca_scores[, seq_len(top_n_pca), drop = FALSE]

# Assign informative names to the PCA components
colnames(df_pca) <- paste0("PC", seq_len(top_n_pca))
pca_components <- colnames(df_pca)


# Load the cleaned phenotype data
df_clean <- read.csv("df_1a_clean.csv")

# Remove columns that should not be included in the partial correlation analysis
exclude_cols <- c("X.1", "X", "age")

phenotype_data <- df_clean[
  ,
  !(colnames(df_clean) %in% exclude_cols),
  drop = FALSE
]

phenotype_variables <- colnames(phenotype_data)


# Combine phenotypic variables and PCA scores
#
# Partial correlations are calculated using all variables in this combined
# dataset. Thus, the association between each PC and each phenotypic variable
# is adjusted for all remaining variables included in the analysis.
partial_cor_data <- cbind(
  phenotype_data,
  df_pca
)


################################################################################
# 3.2 Calculate partial correlations
################################################################################

message("Calculating partial correlation matrix...")

pcor_results <- tryCatch(
  {
    ppcor::pcor(partial_cor_data)
  },
  error = function(e) {
    stop(
      "Partial correlation analysis failed: ",
      conditionMessage(e)
    )
  }
)


# Replace missing estimates and p-values with zero, as in the original analysis
pcor_results$estimate[
  is.na(pcor_results$estimate)
] <- 0

pcor_results$p.value[
  is.na(pcor_results$p.value)
] <- 0


################################################################################
# 3.3 Extract associations for each PUMA dimension
################################################################################

# Thresholds used to select variables
p_value_threshold <- 0.001
partial_correlation_threshold <- 0.2


for (pc in pca_components) {

  message("Processing partial correlations for ", pc)

  # Extract partial correlations between the current PC and all
  # phenotypic variables
  partial_correlations <- pcor_results$estimate[
    phenotype_variables,
    pc
  ]

  p_values <- pcor_results$p.value[
    phenotype_variables,
    pc
  ]


  # Store results
  pc_results <- data.frame(
    variable = phenotype_variables,
    pcor_values = abs(partial_correlations),
    p_values = p_values,
    stringsAsFactors = FALSE
  )


  # Sort variables by statistical significance
  pc_results <- pc_results[
    order(pc_results$p_values),
  ]


  # Bonferroni correction across the phenotypic variables
  pc_results$adjusted_p_values <- p.adjust(
    pc_results$p_values,
    method = "bonferroni"
  )


  # Extract the PC number for output filenames
  pc_number <- sub(
    "PC",
    "",
    pc
  )


  ##############################################################################
  # Save all partial correlation results
  ##############################################################################

  write.csv(
    pc_results,
    file = paste0(
      "pc",
      pc_number,
      "_partial_correlation_pvalues.csv"
    ),
    row.names = FALSE
  )


  ##############################################################################
  # Select variables based on statistical significance
  ##############################################################################

  significant_results <- pc_results[
    pc_results$p_values < p_value_threshold,
  ]

  # Rank significant variables by absolute partial correlation
  significant_results <- significant_results[
    order(
      significant_results$pcor_values,
      decreasing = TRUE
    ),
  ]


  write.csv(
    significant_results,
    file = paste0(
      "pc",
      pc_number,
      "_sorted_pvalues.csv"
    ),
    row.names = FALSE
  )


  ##############################################################################
  # Select variables based on both significance and effect size
  ##############################################################################

  selected_results <- significant_results[
    significant_results$pcor_values >
      partial_correlation_threshold,
  ]


  write.csv(
    selected_results,
    file = paste0(
      "pc",
      pc_number,
      "_filtered_sorted_pvalues_by_partial_correlation.csv"
    ),
    row.names = FALSE
  )
}
