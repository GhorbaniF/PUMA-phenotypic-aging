library(dplyr)
library(tidyr)
library(ggplot2)


################################################################################
# 2.1 Define PCA function
################################################################################

# InDaPCA performs PCA using the correlation matrix of the standardized
# phenotypic variables.
#
# Missing values are handled pairwise when estimating the correlation matrix.
# For calculation of component scores, missing standardized values are set to 0.

InDaPCA <- function(raw_data) {

  # Standardize variables
  X <- scale(
    raw_data,
    center = TRUE,
    scale = TRUE
  )

  # Calculate correlation matrix
  correlation_matrix <- cor(
    X,
    use = "pairwise.complete.obs"
  )

  # Eigendecomposition
  eigen_decomposition <- eigen(
    correlation_matrix
  )

  eigenvalues <- eigen_decomposition$values
  eigenvectors <- eigen_decomposition$vectors

  # Retain positive eigenvalues
  positive_eigenvalues <- eigenvalues[
    eigenvalues > 0
  ]

  positive_eigenvalues_percent <- (
    100 *
      positive_eigenvalues /
      sum(positive_eigenvalues)
  )

  # Replace missing standardized values with zero for calculation
  # of component scores
  X_for_scores <- X
  X_for_scores[
    is.na(X_for_scores)
  ] <- 0

  # Calculate principal component scores
  component_scores <- as.matrix(
    X_for_scores
  ) %*% eigenvectors

  # Standardized component scores used for biplot objects
  positive_components <- eigenvalues > 0

  component_scores_standardized <- sweep(
    component_scores[
      ,
      positive_components,
      drop = FALSE
    ],
    2,
    sqrt(positive_eigenvalues),
    FUN = "/"
  )

  biplot_objects <- (
    component_scores_standardized /
      sqrt(nrow(component_scores) - 1)
  )

  # Variable scores/loadings
  variable_scores <- cor(
    X,
    component_scores,
    use = "pairwise.complete.obs"
  )

  # Variable coordinates used for biplots
  biplot_variables <- (
    variable_scores *
      sqrt(nrow(X) - 1)
  )

  # Return PCA results
  list(
    Correlation.matrix = correlation_matrix,
    Eigenvalues = eigenvalues,
    Positive.Eigenvalues = positive_eigenvalues,
    Positive.Eigenvalues.as.percent = positive_eigenvalues_percent,
    Square.root.of.eigenvalues = sqrt(
      positive_eigenvalues
    ),
    Eigenvectors = eigenvectors,
    Component.scores = component_scores,
    Variable.scores = variable_scores,
    Biplot.objects = biplot_objects,
    Biplot.variables = biplot_variables
  )
}


################################################################################
# 2.2 Prepare phenotypic data for PCA
################################################################################

# Remove non-phenotypic columns before PCA.
#
# Using column names is safer and clearer than removing columns by position.
exclude_cols <- c(
  "X.1",
  "X",
  "age"
)

pca_input <- df_clean[
  ,
  !(colnames(df_clean) %in% exclude_cols),
  drop = FALSE
]


################################################################################
# 2.3 Perform PCA
################################################################################

message("Performing PCA...")

pca_fit <- InDaPCA(
  pca_input
)

# Save complete PCA object
saveRDS(
  pca_fit,
  file = "pca_fit_data.rds"
)

# Extract component scores
pca_scores <- as.data.frame(
  pca_fit$Component.scores
)

# Assign informative component names
colnames(pca_scores) <- paste0(
  "PC",
  seq_len(ncol(pca_scores))
)


################################################################################
# 2.4 Calculate retrieval scores and select dimensions
################################################################################

eigenvalues <- pca_fit$Eigenvalues

# Retrieval score used in the original PUMA analysis.
#
# NOTE:
# This reproduces the original analysis, in which retrieval scores were
# calculated from squared eigenvalues.
total_variation <- sum(
  eigenvalues^2
)

retrieval_score <- (
  eigenvalues^2 /
    total_variation
)

# Select components with retrieval score > 1%
top_n_pca <- sum(
  retrieval_score > 0.01
)

message(
  top_n_pca,
  " components have a retrieval score > 1%."
)


# Prepare data for plotting
retrieval_score_df <- data.frame(
  component = paste0(
    "PC",
    seq_len(top_n_pca)
  ),
  retrieval_score = retrieval_score[
    seq_len(top_n_pca)
  ]
)


# Plot retrieval scores
p_retrieval <- ggplot(
  retrieval_score_df,
  aes(
    x = component,
    y = retrieval_score
  )
) +
  geom_col() +
  labs(
    x = "PCA component",
    y = "Retrieval score",
    title = "Retrieval Scores of Selected PCA Components"
  ) +
  theme(
    axis.text.x = element_text(
      angle = 90,
      vjust = 0.5,
      hjust = 1,
      size = 14
    ),
    axis.text = element_text(
      size = 14
    ),
    axis.title = element_text(
      size = 16
    ),
    plot.title = element_text(
      size = 18,
      hjust = 0.5
    )
  )


ggsave(
  filename = "retrieval_score_PCA_component_top_n.pdf",
  plot = p_retrieval,
  width = 8,
  height = 4
)


################################################################################
# 2.5 Orient component scores
################################################################################

# Orient the selected components consistently with the PUMA analysis.
#
# PC1-PC4 and PC6-PC7 are multiplied by -1.
# PC5 retains its original orientation.

pcs_to_flip <- setdiff(
  seq_len(top_n_pca),
  5
)

for (pc in pcs_to_flip) {

  message(
    "Flipping orientation of PC",
    pc
  )

  pca_scores[
    ,
    pc
  ] <- -pca_scores[
    ,
    pc
  ]
}


################################################################################
# 2.6 Examine component scores across age groups
################################################################################

# Add participant age
pca_scores_with_age <- pca_scores[
  ,
  seq_len(top_n_pca),
  drop = FALSE
]

pca_scores_with_age$age <- df_clean$age


# Create 10-year age groups
pca_scores_with_age <- pca_scores_with_age %>%
  mutate(
    age_group = cut(
      age,
      breaks = seq(
        0,
        100,
        by = 10
      ),
      include.lowest = TRUE
    )
  )


# Convert to long format
pca_scores_long <- pca_scores_with_age %>%
  select(
    age_group,
    all_of(
      paste0(
        "PC",
        seq_len(top_n_pca)
      )
    )
  ) %>%
  pivot_longer(
    cols = starts_with("PC"),
    names_to = "component",
    values_to = "score"
  )


# Calculate mean and standard deviation within each age group
pca_scores_by_age <- pca_scores_long %>%
  group_by(
    component,
    age_group
  ) %>%
  summarise(
    mean_score = mean(
      score,
      na.rm = TRUE
    ),
    sd_score = sd(
      score,
      na.rm = TRUE
    ),
    .groups = "drop"
  )


################################################################################
# 2.7 Plot component scores across age groups
################################################################################

p_age <- ggplot(
  pca_scores_by_age,
  aes(
    x = age_group,
    y = mean_score,
    group = component,
    color = component
  )
) +
  geom_line(
    linewidth = 1.5
  ) +
  labs(
    x = "Age group",
    y = "Mean PCA score",
    color = "Component",
    title = "PCA Scores by Age Group"
  ) +
  theme(
    legend.position = "right",
    axis.text.x = element_text(
      angle = 45,
      hjust = 1
    ),
    axis.text = element_text(
      size = 14
    ),
    axis.title = element_text(
      size = 16
    ),
    plot.title = element_text(
      size = 18,
      hjust = 0.5
    )
  )


ggsave(
  filename = "pca_scores_vs_ages.pdf",
  plot = p_age,
  width = 15,
  height = 12
)
